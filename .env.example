# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────
# Local (docker compose):  mongodb://localhost:27017/caretrack
# Atlas:                   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/caretrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/caretrack

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
COOKIE_NAME=ct_session

# ── CORS / CSRF ───────────────────────────────────────────
# Comma-separated list of allowed browser origins (the Next.js frontend)
FRONTEND_URL=http://localhost:3000

# ── Seed script (npm run seed) ────────────────────────────
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@caretrack.dev
SEED_ADMIN_PASSWORD=CareTrack@2026

# Optional: force the cookie Secure flag (defaults to true when NODE_ENV=production).
# Only set to false for plain-http local Docker runs.
# COOKIE_SECURE=false
